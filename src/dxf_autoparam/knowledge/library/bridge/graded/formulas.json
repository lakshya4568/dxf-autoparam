  {"id": "RCR-VAL-002", "status": "UNKNOWN", "note": "top slab ≥ 0.3 m 'IRS minimum' — not in any source in hand"},
  {"id": "RCR-VAL-003", "status": "DISPUTED", "conflict": "KC-22", "note": "clear height ≥ 1.0 m — IRBM-2024 311(3) gives 1.2 m headroom for new bridges"},
  {"id": "RCR-VAL-007", "status": "UNKNOWN", "conflict": "KC-5", "note": "cushion ≥ 75 mm — unverified"},
  {"id": "RCR-VAL-008", "status": "UNKNOWN", "conflict": "KC-3", "note": "haunch ≥ 0.3 m — unverified; drawings in hand use 200"},
  {"id": "HWB-VAL-007", "status": "UNKNOWN", "note": "highway haunch ≥ 0.15 m — unverified"},
  {"id": "CG-VAL-002", "status": "DISPUTED", "conflict": "KC-16", "note": "girder depth ≥ L/20 (L/20 is a spacing ratio per the secondary source)"},
  {"id": "CG-VAL-006", "status": "DISPUTED", "conflict": "KC-15", "note": "clearance ≥ 1.0 m confuses clearance (IRBM 312 table) with free board (313)"},
  {"id": "PSC-VAL-004", "status": "DISPUTED", "conflict": "KC-15", "note": "HFL clearance ≥ 0.600 m is only the lowest band of IRBM 312(1), measured from the design water level"}
 ],
 "constants": [
  {"symbol": "RAIL_FORMATION_OFFSET", "value": 0.762, "unit": "m", "status": "ASSUMPTION", "bindable": false, "conflict": "KC-1", "sources": [{"source": "SRC-BRIDGE-FORMULAS"}, {"source": "SRC-CLAUDE-RESEARCH", "note": "B12"}]},
  {"symbol": "foundationThickness", "value": 1.219, "unit": "m", "status": "ASSUMPTION", "bindable": false, "sources": [{"source": "SRC-CLAUDE-RESEARCH", "note": "B11 — equals 4 ft; do not hard-code"}]},
  {"symbol": "MIN_EARTH_CUSHION", "value": 0.075, "unit": "m", "status": "UNKNOWN", "bindable": false, "conflict": "KC-5", "sources": [{"source": "SRC-BRIDGE-FORMULAS"}]},
