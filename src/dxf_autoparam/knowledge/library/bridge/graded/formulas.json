  {"id": "HPC-LVL-008", "status": "ASSUMPTION", "conflict": "KC-1", "note": "rail = formation + 0.762 written as a literal"},
  {"id": "RCR-LVL-007", "status": "DISPUTED", "conflict": "KC-2", "note": "FW + 4·cushion with a '1:1 slope' contradicts itself (a 1:1 slope gives FW + 2H)"},
  {"id": "HPC-GEO-007", "status": "DISPUTED", "conflict": "KC-2", "note": "the same barrel-length formula for pipes"},
