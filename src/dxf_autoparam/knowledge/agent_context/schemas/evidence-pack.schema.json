{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentctx evidence pack (packs/pack-*.json)",
  "description": "A focused, derived bundle for one record and one task. A pack is never a source, never a label and never accepted knowledge. Every claim cites stored evidence ids.",
  "x-schema-version": "1.0",
  "type": "object",
  "required": ["pack_id", "pack_version", "pack_kind", "derived", "generator", "built_from", "task", "subject", "completeness", "source_references", "source_fingerprints", "input_hashes", "claims", "candidate_interpretations", "formulas", "component_definitions", "conflicts", "unresolved_questions", "live_cad_binding", "permitted_next_actions", "blocked_next_actions", "agent_summary"],
  "properties": {
    "pack_id": {"type": "string", "pattern": "^pack-[0-9a-f]{16}$"},
    "pack_version": {"type": "string"},
    "pack_kind": {"const": "derived_evidence_pack"},
    "derived": {"const": true},
    "generator": {"type": "string"},
    "built_from": {"type": "object"},
    "task": {"type": "object", "required": ["name", "description", "requested_scope"], "properties": {"name": {"enum": ["source_evidence", "component_interpretation", "dimension_binding", "geometric_relationships"]}}},
    "subject": {"type": "object", "required": ["record_id", "kind"]},
    "completeness": {"type": "object", "required": ["status", "capabilities", "missing", "notes"], "properties": {"capabilities": {"type": "object", "properties": {"verified_values": {"const": 0}}}}},
    "source_references": {"type": "array", "items": {"type": "object", "required": ["record_id", "fingerprint"]}},
    "source_fingerprints": {"type": "object"},
    "input_hashes": {"type": "object"},
    "claims": {"type": "array", "items": {"type": "object", "required": ["claim_id", "kind", "statement", "evidence_ids", "source_ids", "trust", "eligibility"]}},
    "candidate_interpretations": {"type": "array", "items": {"type": "object", "required": ["status", "binding"], "properties": {"binding": {"type": "object", "required": ["status"], "properties": {"status": {"const": "blocked"}}}}}},
    "formulas": {"type": "array", "items": {"type": "object", "properties": {"executed": {"const": false}}}},
    "component_definitions": {"type": "array"},
    "conflicts": {"type": "array"},
    "unresolved_questions": {"type": "array"},
    "live_cad_binding": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["unavailable", "invalid", "available"]}}},
    "permitted_next_actions": {"type": "array", "items": {"type": "string"}},
    "blocked_next_actions": {"type": "array", "items": {"type": "object", "required": ["action", "reason"]}},
    "agent_summary": {"type": "string", "minLength": 1},
    "observations": {"type": "object"},
    "truncation": {"type": "object"},
    "binding_policy": {"type": "string"}
  }
}
