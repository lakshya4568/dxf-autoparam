{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentctx knowledge record (knowledge/knowledge.jsonl)",
  "description": "A normalised knowledge item with its category (B reference, C vocabulary, D proposed or disputed, E operational) and the trust labels the repository recorded. Expressions are text and are never executed.",
  "x-schema-version": "1.0",
  "type": "object",
  "required": ["id", "category", "topic", "title", "statement", "trust", "citations", "proposal_status", "source_path", "fingerprint", "eligibility", "issues", "raw"],
  "properties": {
    "id": {"type": "string"},
    "kb_id": {"type": ["string", "null"]},
    "category": {"enum": ["B", "C", "D", "E"]},
    "category_name": {"type": "string"},
    "topic": {"type": "string"},
    "kind": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "aliases": {"type": "array"},
    "statement": {"type": ["string", "null"]},
    "interpretation": {"type": ["string", "null"]},
    "expression": {"type": ["object", "null"], "properties": {"executed": {"const": false}}},
    "applies_families": {"type": "array"},
    "trust": {"type": "object"},
    "citations": {"type": "array"},
    "internal_source_ids": {"type": "array"},
    "conflicts": {"type": "array"},
    "relations": {"type": "array"},
    "retrieval_pointers": {"type": "array"},
    "rdso_mentions": {"type": "array"},
    "sheet_refs": {"type": "array"},
    "proposal_status": {"type": "string", "pattern": "^(none|unmerged:)"},
    "source_path": {"type": "string"},
    "source_line": {"type": ["integer", "null"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "search_text": {"type": "string"},
    "eligibility": {"type": "object", "required": ["retrieval", "binding", "finetune"]},
    "issues": {"type": "array", "items": {"type": "string", "pattern": "^issue:"}},
    "raw": {}
  }
}
