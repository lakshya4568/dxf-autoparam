# Copy to .env (git-ignored). Everything is optional: without it the project comes from
# `gcloud config get-value project` and credentials from `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
VERTEX_THINKING_LEVEL=high
# Optional numeric thinking token budget (e.g. 24576, 32768, 65536; -1 for dynamic):
# VERTEX_THINKING_BUDGET=65536
# Every agent turn thinks at VERTEX_THINKING_LEVEL (changing the level between turns loses the provider's cache: in a measured run it halved what was served
# from it, while thinking was 1.2% of the tokens billed). Uncomment to pin every turn after the first to another level:
# VERTEX_AGENT_STEP_THINKING=medium
# Or let each turn think at the level the turn before it calls for (low after reading and bookkeeping, high after the candidates or a refusal; never above
# VERTEX_THINKING_LEVEL) — only worth it where the provider's cache is not what the run leans on:
# AUTOPARAM_AGENT_ADAPTIVE_THINKING=1
# A run pauses after this many turns (a chunk; 0 = never), and a unit that has taken this many turns is told to keep what holds and move on (0 = never told):
# AUTOPARAM_SOFT_TURNS=30
# AUTOPARAM_UNIT_TURNS=12
# The agent's conversation is cached by the provider (implicit caching) while it only grows; "explicit" keeps the explicit cache below for it from the start
# (a run also takes it by itself when its records show the provider is not caching):
# AUTOPARAM_AGENT_CACHE=implicit
# also the server's deadline (the SDK sends it as X-Server-Timeout): too short and long thinking ends in a 504
VERTEX_TIMEOUT_MS=600000
# thinking counts against the output budget; a reply cut off at it is retried with less thinking
VERTEX_MAX_OUTPUT_TOKENS=65536
VERTEX_FALLBACK_MODEL=gemini-3.7-flash
VERTEX_FALLBACK_THINKING_LEVEL=high
# a model that could not answer a whole call (out of capacity, or past its deadline) is not asked first again for this many seconds, doubled for each probe
# that fails again (at most 30 minutes): the next turns start on the fallback instead of paying for two failed attempts first. 0 switches it off
# VERTEX_BREAKER_S=300

# USD per million tokens, from your billing page: the ledger and the monitor show a model's cost only when it has a price (nothing is guessed):
# VERTEX_PRICES={"gemini-3.8-flash": {"input": 0.0, "cached": 0.0, "output": 0.0}}

# explicit prompt cache for the part of a request that repeats within a run (prompt, pictures, knowledge, CAD JSON)
VERTEX_EXPLICIT_CACHE=1
VERTEX_CACHE_TTL_S=1200

# Experiential Labs gateway (OpenAI-compatible): a second model provider for the agent. Base URL: https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=

# Token Harbor (https://tokenharbor.ai; OpenAI-compatible): other providers' models for the agent, some of them free — the way to keep working when Vertex's credits or
# capacity are out. With a key, the page's model picker also lists the models it prices at zero ("· free (Token Harbor)"; nothing is billed for them, so nothing asks first).
# The key is a secret: here only (this file is git-ignored), never in the page. `uv run python tools/tokenharbor_check.py` lists the models; `--test` makes one tiny call to a free one.
TOKENHARBOR_API_KEY=
# TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
# which models the picker offers: free (default) | all (every model it lists, with its price) | a comma-separated list of ids
# TOKENHARBOR_MODELS=free
